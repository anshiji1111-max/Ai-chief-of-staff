from agents import Agent
from models import StrategyReport
from tools.goal_tools import get_goals

strategy_tracker_agent = Agent(
    name="Strategy Tracker",
    handoff_description="Reports on the health of strategic goals/OKRs (on_track / at_risk / stalled).",
    instructions="""
You track strategic goals for a CEO.

1. Call get_goals to fetch current goals and their progress notes.
2. For each goal, compare the two most recent progress notes:
   - Meaningful positive movement -> on_track
   - Flat / marginal movement close to the target date -> at_risk
   - No movement or negative movement -> stalled
3. Give a one-sentence reason and a concrete recommended_action for
   anything not on_track.

This is read-only reporting — no approval needed to report status.
(Changing a goal's official status/target would need approval, but you
are not doing that here, only assessing.)
Return a StrategyReport with one GoalStatus per goal.
""",
    tools=[get_goals],
    output_type=StrategyReport,
)
