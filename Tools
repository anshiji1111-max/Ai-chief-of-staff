        {"title": "Competitor X raises prices 8%", "url": "https://example.com/competitor-x"},
        {"title": "SaaS benchmarks Q2 2026", "url": "https://example.com/saas-benchmarks"},
    ]
}


@function_tool
def web_search(wrapper: RunContextWrapper[AppContext], query: str) -> list[dict]:
    """Search the web for a query and return a short list of result titles/URLs (mocked)."""
    return _MOCK_RESULTS.get(query.lower(), _MOCK_RESULTS["default"])
