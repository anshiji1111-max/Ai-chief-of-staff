def send_email_impl(thread_id: str, body: str) -> str:
    """
    Plain (non-tool-wrapped) implementation, called directly from the human
    approval loop in main.py AFTER a human has approved the action — never
    exposed to an agent as a callable tool, so an agent can never send mail
    on its own.
    """
    # In a real system this would call the Gmail/Outlook send endpoint.
    return f"[MOCK SEND] Reply to thread {thread_id} sent: {body[:60]}..."

