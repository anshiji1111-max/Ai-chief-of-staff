from agents import function_tool, RunContextWrapper
from context import AppContext


@function_tool
def request_human_approval(
    wrapper: RunContextWrapper[AppContext],
    action_type: str,
    description: str,
    payload_json: str,
) -> str:
    """
    Register an action as pending human approval instead of executing it
    immediately. Use this for anything external/irreversible: sending an
    email, committing to a meeting time with an external party, or closing
    out a strategic goal. Returns an approval_id; the action must not be
    executed until a human approves it via the CLI prompt in main.py.
    """
    import json

    ctx = wrapper.context
    payload = json.loads(payload_json)
    approval_id = ctx.add_pending_approval(action_type, description, payload)
    return approval_id
